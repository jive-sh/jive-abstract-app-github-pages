{
  "$schema": "./package.schema.json",
  "license": "MIT",
  "name": "jive-abstract-app-github-pages",
  "version": "0.1.0",
  "description": "Jive abstract for static sites served by GitHub Pages: builds the site, then publishes it to the repository's gh-pages branch and has GitHub Pages build it, with its custom domain",
  "type": "module",
  "peerDependencies": {
    "effect": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0",
    "effective-modules": "0.3.1-effect4",
    "jive-abstract-library": "0.13.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "effect": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "jive:cicd:get-config": "jive-library cicd get-config",
    "jive:cicd:build": "jive-library cicd build",
    "jive:cicd:audit": "tsc --noEmit -p tsconfig.json && bun test",
    "jive:cicd:deploy:plan": "jive-library cicd deploy-plan",
    "jive:cicd:upload-artifacts": "jive-library cicd upload-artifacts",
    "jive:cicd:deploy": "jive-library cicd deploy",
    "dev": "jive-library dev"
  },
  "jive": {
    "cicd": {
      "deploy": {
        "verb": "Publish Tag",
        "branches": {
          "main": [
            "latest"
          ]
        },
        "previews": false,
        "sequentially": true
      },
      "runsOnPullRequests": true,
      "runsOn": "ubuntu-latest",
      "requiredSecrets": [
        "NPM_TOKEN"
      ]
    },
    "library": {
      "daemons": [],
      "provisionWithJive": null
    }
  }
}
